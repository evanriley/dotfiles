type = process
command = /usr/bin/podman run --rm --replace --pull never --name adguardhome
# Root inside the container, which is what lets it bind 53 there; rootless
# podman maps that root to uid 1000 on the host. NET_BIND_SERVICE is the only
# capability worth keeping, and the binary is a single Go executable that
# never needs to gain privileges.
command += --cap-drop all --cap-add NET_BIND_SERVICE
command += --security-opt no-new-privileges
# Publishing 53 on the host needs net.ipv4.ip_unprivileged_port_start lowered
# to 53 in /etc/sysctl.d/; rootless podman cannot bind below it and the
# container fails to start with "Listen failed for HOST UDP port .../53".
command += --publish ${TAILNET_ADDRESS:-127.0.0.1}:53:53/udp
command += --publish ${TAILNET_ADDRESS:-127.0.0.1}:53:53/tcp
# The setup wizard serves on 3000, then writes whichever admin port it was
# given into http.address. Its default there is 80, which this service does
# not publish, and the result is an admin interface reachable from nowhere.
# Keeping it on 3000 means one published port for the life of the service; a
# fresh install that lands on 80 is fixed by setting http.address to
# 0.0.0.0:3000 in AdGuardHome.yaml and restarting.
command += --publish ${TAILNET_ADDRESS:-127.0.0.1}:3000:3000/tcp
command += --volume /home/evan/.local/share/adguardhome/work:/opt/adguardhome/work:rw
command += --volume /home/evan/.local/share/adguardhome/conf:/opt/adguardhome/conf:rw
command += docker.io/adguard/adguardhome:v0.107.79
restart = yes
smooth-recovery = yes
restart-delay = 10
restart-limit-count = 0
stop-timeout = 20
env-file = tailnet.env
depends-on = tailnet-ready
waits-for = container-logs
# Persistent file, not log-type = buffer: a buffer is lost at session end and
# discards output once full, so a container failure could leave no record.
# container-logs truncates this directory once per session to bound growth.
logfile = /home/evan/.local/state/containers/adguardhome.log
logfile-permissions = 600
