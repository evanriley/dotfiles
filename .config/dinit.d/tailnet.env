# The tailnet address every container service publishes on. Regenerate with
# `tailscale ip -4` if this node is removed from the tailnet and re-added.
#
# Each service substitutes it as ${TAILNET_ADDRESS:-127.0.0.1}, so losing this
# file costs reachability rather than publishing a service to the LAN: dinit
# replaces an undefined variable with an empty string, and an empty --publish
# address means every interface.
TAILNET_ADDRESS=100.103.179.116
