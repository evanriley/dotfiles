type = process
command = /home/evan/.config/darkman/swaybg-run
restart = yes
smooth-recovery = yes
restart-delay = 2
# The darkman theme hook restarts this service on every mode change to pick up
# the new wallpaper colour. A rate limit cannot tell those restarts from a
# crash loop, and once tripped it leaves the desktop with no wallpaper for the
# session, so it is off -- as it is for the other externally restarted
# services.
restart-limit-count = 0
log-type = buffer
log-buffer-size = 65536
depends-on = graphical.target
