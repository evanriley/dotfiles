type = process
command = /usr/bin/podman run --rm --replace --pull never --name navidrome
command += --userns keep-id --user 1000:1000 --security-opt no-new-privileges
command += --cap-drop all --read-only --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m
command += --publish 127.0.0.1:4533:4533
command += --volume /home/evan/.local/share/navidrome:/data:rw
command += --volume /mnt/Media/Music:/music:ro
command += docker.io/deluan/navidrome:0.63.2
restart = yes
smooth-recovery = yes
restart-delay = 10
restart-limit-count = 0
stop-timeout = 20
# Persistent file, not log-type = buffer: a buffer is lost at session end and
# discards output once full, so a container failure could leave no record.
# navidrome-log truncates this file once per session to bound its growth.
logfile = /home/evan/.local/state/navidrome.log
logfile-permissions = 600
waits-for = navidrome-log
