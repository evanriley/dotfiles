type = process
command = /usr/bin/podman run --rm --replace --pull never --name dispatcharr
# No --user, no --read-only and no no-new-privileges, unlike the other
# containers here. The all-in-one image boots postgres, redis, nginx and
# celery from a single root entrypoint that drops privilege with setuid su;
# that hardening would stop it starting. podman's default capability set is
# what it needs, and rootless podman already maps its root to uid 1000.
# The integrated Radeon (PCI 76:00.0), shared with jellyfin, for the ffmpeg
# transcoding dispatcharr does on proxied streams and recordings. Named
# directly rather than by PCI path because podman splits --device on ":".
command += --device /dev/dri/renderD129:/dev/dri/renderD128
command += --publish ${TAILNET_ADDRESS:-127.0.0.1}:9191:9191
command += --env DISPATCHARR_ENV=aio
command += --env REDIS_HOST=localhost
command += --env CELERY_BROKER_URL=redis://localhost:6379/0
command += --env DISPATCHARR_LOG_LEVEL=info
command += --volume /home/evan/.local/share/dispatcharr:/data:rw
command += ghcr.io/dispatcharr/dispatcharr:0.8.0
restart = yes
smooth-recovery = yes
restart-delay = 10
restart-limit-count = 0
# Longer than the others: postgres is shut down inside the container.
stop-timeout = 30
env-file = tailnet.env
depends-on = tailnet-ready
waits-for = container-logs
# Persistent file, not log-type = buffer: a buffer is lost at session end and
# discards output once full, so a container failure could leave no record.
# container-logs truncates this directory once per session to bound growth.
logfile = /home/evan/.local/state/containers/dispatcharr.log
logfile-permissions = 600
