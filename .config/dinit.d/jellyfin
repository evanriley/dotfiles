type = process
command = /usr/bin/podman run --rm --replace --pull never --name jellyfin
command += --userns keep-id --user 1000:1000 --security-opt no-new-privileges
command += --cap-drop all
# The integrated Radeon (PCI 76:00.0), not the discrete RX 9070 XT (03:00.0),
# so transcoding never contends with a game for the dGPU. The by-path name is
# the stable one, but podman splits --device on ":" and a PCI path is full of
# them, so the node is named directly and presented in-container under the
# number Jellyfin probes first. Re-check after a hardware change with
# `ls -l /dev/dri/by-path`.
command += --device /dev/dri/renderD129:/dev/dri/renderD128
command += --publish ${TAILNET_ADDRESS:-127.0.0.1}:8096:8096
command += --volume /home/evan/.local/share/jellyfin/config:/config:rw
command += --volume /home/evan/.local/share/jellyfin/cache:/cache:rw
# Read-only media: Jellyfin is a player here, not a library manager. Metadata
# and trickplay images live under /config, which is its default anyway.
command += --volume /mnt/Media/Movies:/media/movies:ro
command += --volume /mnt/Media/TV:/media/tv:ro
command += docker.io/jellyfin/jellyfin:10.11.11
restart = yes
smooth-recovery = yes
restart-delay = 10
restart-limit-count = 0
stop-timeout = 20
env-file = tailnet.env
depends-on = tailnet-ready
waits-for = container-logs
# Persistent file, not log-type = buffer: a buffer is lost at session end and
# discards output once full, so a container failure could leave no record.
# container-logs truncates this directory once per session to bound growth.
logfile = /home/evan/.local/state/containers/jellyfin.log
logfile-permissions = 600
