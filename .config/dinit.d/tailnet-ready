# Readiness gate for every container published on the tailnet. tailscaled is a
# system service, which a user service cannot name as a dependency, so the
# address is waited for rather than declared. Container services depend on
# this rather than waits-for it: a container that cannot bind its address is
# not worth starting.
type = scripted
command = /home/evan/.config/scripts/wait-for-tailnet
env-file = tailnet.env
# Longer than the script's own 90s budget, so the script reports which address
# was missing instead of dinit reporting a timeout.
start-timeout = 120
logfile = /home/evan/.local/state/containers/tailnet-ready.log
logfile-permissions = 600
