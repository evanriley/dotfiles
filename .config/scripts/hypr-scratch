#!/usr/bin/env bash
set -euo pipefail

name="${1:?usage: hypr-scratch <rmpc|btop>}"

case "$name" in
  rmpc)
    class="scratch_rmpc"
    command="rmpc"
    ;;
  btop)
    class="scratch_btop"
    command="btop"
    ;;
  *)
    exit 2
    ;;
esac

if ! hyprctl clients -j | jq -e --arg class "$class" \
  '.[] | select(.class == $class)' >/dev/null; then
  hyprctl dispatch exec \
    "[workspace special:${name} silent] foot --app-id ${class} -e ${command}"
  sleep 0.2
fi

hyprctl dispatch togglespecialworkspace "$name"
