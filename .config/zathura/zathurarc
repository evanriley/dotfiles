# Behavior shared by Kanso Pearl and Kanso Zen.
set font "Berkeley Mono 12"
set guioptions "s"
set adjust-open "best-fit"
set page-mode "equal_width"
set pages-per-row 1
set scroll-step 50
set scroll-page-aware true
set scroll-full-overlap 0.05
set selection-clipboard "clipboard"
set selection-notification false
set continuous-hist-save true
set database "sqlite"
set statusbar-basename true
set statusbar-home-tilde true
set window-title-basename true
set window-title-home-tilde true

set default-bg "#090e13"
set default-fg "#c5c9c7"
set statusbar-bg "#1f1f28"
set statusbar-fg "#c5c9c7"
set recolor false
