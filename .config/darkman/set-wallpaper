#!/bin/sh

set -eu

# Point the wallpaper at a mode. dinit owns the swaybg process: this script
# killing and respawning it meant two callers -- niri at login and the darkman
# hook on every transition -- could interleave a kill between the other's kill
# and its own start, leaving two swaybg processes and two wallpaper layer
# surfaces stacked in the backdrop. A service has one process by construction.

state_root=${XDG_STATE_HOME:-$HOME/.local/state}/darkman
mode=${1:-$(darkman get 2>/dev/null || printf dark)}

case "$mode" in
light | dark) ;;
*)
    printf 'set-wallpaper: unknown mode: %s.\n' "$mode" >&2
    printf 'expected light or dark.\n' >&2
    printf 'check: darkman get\n' >&2
    exit 2
    ;;
esac

mkdir -p "$state_root"
printf '%s\n' "$mode" >"$state_root/wallpaper-mode"

# Restart is the wrong request for a service that has never run, which is the
# case on the first call of a session.
if dinitctl is-started swaybg >/dev/null 2>&1; then
    exec dinitctl restart swaybg
fi
exec dinitctl start swaybg
