workspace "web"
workspace "social"
workspace "game"
workspace "misc"
workspace "system"
workspace "scratch"
environment {
    QT_QPA_PLATFORMTHEME "gtk3"
    PATH "/home/evan/bin:/home/evan/.local/bin:/home/evan/go/bin:/home/evan/.cargo/bin:/home/evan/.zvm/bin:/home/evan/.zvm/self:/usr/local/bin:/usr/bin:/bin"
}

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 300
        repeat-rate 90
        numlock
    }
    touchpad {
        tap
        dwt
        dwtp
    }
    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="90%"
    workspace-auto-back-and-forth
}

output "DP-2" {
    mode "5120x1440@119.979"
    scale 1
    transform "normal"
}
cursor {
    xcursor-theme "Bibata-Original-Classic"
    xcursor-size 24
}
layout {
    gaps 6
    center-focused-column "never"
    always-center-single-column
    background-color "transparent"
    preset-column-widths {
        proportion 0.25
        proportion 0.5
        proportion 0.75
    }
    default-column-width {
        proportion 0.5
    }
    focus-ring {
        off
        width 1
        active-color 255 200 127 255
        inactive-color 80 80 80 255
    }
    border {
        off
        width 1
        active-gradient from="#090E13" to="#C14043" angle=45 relative-to="workspace-view"
        // inactive-gradient from="#0d0c0c" to="#808080" angle=45 relative-to="workspace-view"
        // active-color 34 38 45 255
        inactive-color "#090D12"
    }
    tab-indicator {
        // off
        // hide-when-single-tab
        place-within-column
        gap 5
        width 4
        length total-proportion=1.0
        position "left"
        gaps-between-tabs 2
        corner-radius 0
        // active-color "yellow"
        // inactive-color "gray"
        // urgent-color "blue"
        active-gradient from="#c4b28a" to="#c4746e" angle=45
        inactive-gradient from="#0d0c0c" to="#808080" angle=45 relative-to="workspace-view"
        urgent-gradient from="#E46876" to="#c4746e" angle=45
    }
    shadow {
        on
        softness 10
        spread 5
        offset x=0 y=5
        draw-behind-window false
        color "#090D1270"
        inactive-color "#00000054"
    }
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
}

spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"

spawn-at-startup "/home/evan/.local/share/darkman/set-wallpaper"

// Supervise the long-running desktop daemons and retain their logs with dinit.
spawn-at-startup "dinitctl" "start" "desktop-services"

spawn-at-startup "foot" "--app-id=scratch_rmpc" "rmpc"
spawn-at-startup "foot" "--app-id=scratch_btop" "btop"

// spawn-at-startup "firefox"

spawn-at-startup "flatpak" "run" "com.valvesoftware.Steam" "-silent"


spawn-at-startup "flatpak" "run" "com.discordapp.Discord"

spawn-at-startup "flatpak" "run" "dev.deedles.Trayscale"

// spawn-at-startup "flatpak" "run" "io.gitlab.librewolf-community"

// Pika Backup requests autostart through the background portal, which keeps
// ~/.config/autostart in step with the setting inside the app. Spawning the
// monitor here as well started it twice.

hotkey-overlay {
    skip-at-startup
}
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
gestures {
    hot-corners {
        off
    }
}
overview {
    zoom 0.6
    workspace-shadow {
        off
    }
}

// Keep darkman's current swaybg wallpaper visible behind the overview.
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

animations {
    // NOTE: Uncomment to turn off all animations
    // NOTE: We can also put "off" into each individual animation to disable it.
    // off
    // HACK: Slow down all animations by this factor. Values below 1 speed them up instead.
    slowdown 0.8
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}
// Transparency and blur
window-rule {
    match is-active=true
    // Apply to all windows
    opacity 0.95
}
window-rule {
    match is-active=false
    // Apply to all windows
    opacity 0.95
}
window-rule {
    match app-id="io.github.manta"
    opacity 1.0
}
// Niri can detect individual-window screencasts. Keep the shared target fully
// opaque so screen shares and recordings do not inherit cosmetic transparency.
window-rule {
    match is-window-cast-target=true
    opacity 1.0

    // Luna error red: conspicuous without introducing a color outside the theme.
    focus-ring {
        on
        width 3
        active-color "#e08585"
        inactive-color "#e08585"
    }

    shadow {
        color "#e0858570"
        inactive-color "#e0858570"
    }

    tab-indicator {
        active-color "#e08585"
        inactive-color "#e08585"
    }
}
// Open the Firefox picture-in-picture player as floating by default.
window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    open-floating true
}
window-rule {
    match app-id="firefox"
    open-on-workspace "web"
    open-maximized-to-edges false
}
window-rule {
    match app-id="librewolf"
    open-on-workspace "web"
    open-maximized-to-edges false
}
window-rule {
    match app-id="org.qutebrowser.qutebrowser"
    open-on-workspace "web"
    open-maximized-to-edges false
}
window-rule {
    match app-id="librewolf$" title="^Picture-in-Picture$"
    open-floating true
}
window-rule {
    match app-id="(com\\.brave\\.Browser|brave-browser|Brave-browser)"
    open-on-workspace "web"
    open-maximized-to-edges false
}
window-rule {
    match app-id="(discord|com\\.discordapp\\.Discord)"
    open-on-workspace "social"
    open-maximized-to-edges false
    opacity 1.0
}
window-rule {
    match app-id="org.mozilla.Thunderbird"
    open-on-workspace "social"
}
window-rule {
    match app-id="org.gnome.World.PikaBackup"
    open-on-workspace "system"
}
window-rule {
    match app-id="(org\\.gnome\\.Nautilus|nautilus)"
    open-floating true
    default-column-width {
        fixed 1400
    }
    default-window-height {
        fixed 900
    }
}
window-rule {
    match app-id="dev.deedles.Trayscale"
    open-on-workspace "system"
    open-floating true
    default-column-width {
        fixed 520
    }
    default-window-height {
        fixed 620
    }
}
window-rule {
    match app-id="steam"
    open-on-workspace "game"
}
window-rule {
    match app-id="org.nicotine_plus.Nicotine"
    open-on-workspace "misc"
    open-maximized-to-edges false
}
window-rule {
    match app-id="steam" title="^notificationtoasts_\\d+_desktop$"
    default-floating-position x=10 y=10 relative-to="bottom-right"
}
window-rule {
    match app-id="Bitwarden"
    default-column-width {
        proportion 0.25
    }
}
window-rule {
    match app-id="foot"
    default-column-width {
        proportion 0.25
    }
}
window-rule {
    match app-id="qute-editor"
    open-floating true
    default-column-width {
        fixed 1200
    }
    default-window-height {
        fixed 900
    }
    opacity 1.0
}
window-rule {
    match title="Friends List"
    open-on-workspace "game"
    default-column-width {
        fixed 600
    }
    default-window-height {
        fixed 700
    }
}
window-rule {
    match app-id="scratch_rmpc"
    open-on-workspace "scratch"
    open-floating true
    default-column-width {
        fixed 1920
    }
    default-window-height {
        fixed 1080
    }
}
window-rule {
    match app-id="scratch_btop"
    open-on-workspace "scratch"
    open-floating true
    default-column-width {
        fixed 1920
    }
    default-window-height {
        fixed 1080
    }
}
window-rule {
    match app-id="mpv"
    open-floating true
    default-column-width {
        fixed 1920
    }
    default-window-height {
        fixed 1080
    }
    opacity 1.0
}
window-rule {
    match app-id="swayimg"
    open-floating true
    default-column-width {
        fixed 1280
    }
    default-window-height {
        fixed 800
    }
    opacity 1.0
}
window-rule {
    match app-id="((google-)?[cC]hrom(e|ium)|com\\.brave\\.Browser|[bB]rave-browser|[mM]icrosoft-edge|Vivaldi-stable|helium)"
    opacity 1.0
}
window-rule {
    match app-id="([fF]irefox|firefox-bin|org\\.mozilla\\.firefox|zen|app\\.zen_browser\\.zen|librewolf|io\\.gitlab\\.librewolf-community)"
    opacity 1.0
}
window-rule {
    match app-id="(org\\.qutebrowser\\.qutebrowser|qutebrowser)"
    opacity 1.0
}
// Qutebrowser specifically on YouTube
window-rule {
    match app-id="(org\\.qutebrowser\\.qutebrowser|qutebrowser)" title=".*YouTube.*"
    opacity 1.0
}
window-rule {
    match title="((?i)(?:[a-z0-9-]+\\.)*youtube\\.com_/|app\\.zoom\\.us_/wc/home)"
    opacity 1.0
}
window-rule {
    match app-id="org.pulseaudio.pavucontrol"
    open-floating true
    default-column-width {
        fixed 800
    }
    default-window-height {
        fixed 600
    }
}
window-rule {
    // Steam games do not consistently use steam_app_<id>; native and Proton
    // games often expose their executable name instead.
    match app-id="(?i)(^steam_app_\\d+$|\\.x86(?:_64)?$|\\.exe$|^gamescope$)"
    opacity 1.0
}
window-rule {
    match app-id="^steam_app_\\d+$"
    default-column-width {
        fixed 2560
    }

    default-window-height {
        fixed 1440
    }
}

window-rule {
    match app-id="sh.ppy.osu"

    default-column-width {
        fixed 2560
    }

    default-window-height {
        fixed 1440
    }
}

window-rule {
    match app-id="bg3"
    opacity 1.0
}
binds {
    Mod+Shift+C hotkey-overlay-title="Screencast: Pick Window" repeat=false {
        spawn-sh "niri msg action set-dynamic-cast-window --id $(niri msg --json pick-window | jq -r .id)"
    }
    Mod+Shift+Ctrl+C hotkey-overlay-title="Screencast: Set Focused Window" repeat=false {
        set-dynamic-cast-window
    }
    Mod+Shift+Alt+C hotkey-overlay-title="Screencast: Clear Target" repeat=false {
        clear-dynamic-cast-target
    }
    MOD+SHIFT+SLASH {
        show-hotkey-overlay
    }
    MOD+RETURN hotkey-overlay-title="Open Terminal: foot" {
        spawn "foot"
    }
    Mod+SPACE hotkey-overlay-title="Run an Application: fuzzel" {
        spawn "fuzzel"
    }
    Mod+P hotkey-overlay-title="Open Power Menu: Power Menu" {
        spawn-sh "~/.config/scripts/powermenu"
    }
    MOD+ALT+L hotkey-overlay-title="Lock Screen: swaylock" allow-when-locked=true {
        spawn "swaylock" "-f"
    }
    MOD+E hotkey-overlay-title="File Manager: Nautilus" {
        spawn-sh "nautilus"
    }
    MOD+CTRL+S {
        spawn-sh "~/.config/scripts/ns.py -id scratch_rmpc"
    }
    MOD+CTRL+T {
        spawn-sh "~/.config/scripts/ns.py -id scratch_btop"
    }
    MOD+CTRL+N {
        spawn-sh "swaync-client -t"
    }
    MOD+ALT+V hotkey-overlay-title="Clipboard History: fuzzel" {
        spawn-sh "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"
    }
    MOD+ALT+M hotkey-overlay-title="Watch Media: rofi" {
        spawn-sh "~/.config/scripts/watch-media"
    }
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "/home/evan/.local/bin/swayosd-client" "--output-volume" "raise"
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn "/home/evan/.local/bin/swayosd-client" "--output-volume" "lower"
    }
    XF86AudioMute allow-when-locked=true {
        spawn "/home/evan/.local/bin/swayosd-client" "--output-volume" "mute-toggle"
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn "/home/evan/.local/bin/swayosd-client" "--input-volume" "mute-toggle"
    }
    XF86AudioPlay allow-when-locked=true {
        spawn "/home/evan/.local/bin/swayosd-client" "--playerctl" "play-pause"
    }
    XF86AudioStop allow-when-locked=true {
        spawn "/home/evan/.local/bin/swayosd-client" "--playerctl" "stop"
    }
    XF86AudioPrev allow-when-locked=true {
        spawn "/home/evan/.local/bin/swayosd-client" "--playerctl" "prev"
    }
    XF86AudioNext allow-when-locked=true {
        spawn "/home/evan/.local/bin/swayosd-client" "--playerctl" "next"
    }
    Mod+O repeat=false {
        toggle-overview
    }
    MOD+Q {
        close-window
    }
    Mod+H {
        focus-column-left
    }
    Mod+J {
        focus-window-down
    }
    Mod+K {
        focus-window-up
    }
    Mod+L {
        focus-column-right
    }
    Mod+W {
        toggle-column-tabbed-display
    }
    Mod+Shift+H {
        move-column-left
    }
    Mod+Shift+J {
        move-window-down
    }
    Mod+Shift+K {
        move-window-up
    }
    Mod+Shift+L {
        move-column-right
    }
    Mod+Home {
        focus-column-first
    }
    Mod+End {
        focus-column-last
    }
    Mod+Ctrl+Home {
        move-column-to-first
    }
    Mod+Ctrl+End {
        move-column-to-last
    }
    Mod+Ctrl+H {
        focus-monitor-left
    }
    Mod+Ctrl+J {
        focus-monitor-down
    }
    Mod+Ctrl+K {
        focus-monitor-up
    }
    Mod+Ctrl+L {
        focus-monitor-right
    }
    Mod+Shift+Ctrl+H {
        move-column-to-monitor-left
    }
    Mod+Shift+Ctrl+J {
        move-column-to-monitor-down
    }
    Mod+Shift+Ctrl+K {
        move-column-to-monitor-up
    }
    Mod+Shift+Ctrl+L {
        move-column-to-monitor-right
    }
    Mod+Page_Down {
        focus-workspace-down
    }
    Mod+Page_Up {
        focus-workspace-up
    }
    Mod+U {
        focus-workspace-down
    }
    Mod+I {
        focus-workspace-up
    }
    Mod+Shift+Page_Down {
        move-column-to-workspace-down
    }
    Mod+Shift+Page_Up {
        move-column-to-workspace-up
    }
    Mod+Shift+U {
        move-column-to-workspace-down
    }
    Mod+Shift+I {
        move-column-to-workspace-up
    }
    Mod+Shift+Ctrl+Page_Down {
        move-workspace-down
    }
    Mod+Shift+Ctrl+Page_Up {
        move-workspace-up
    }
    Mod+Shift+Ctrl+U {
        move-workspace-down
    }
    Mod+Shift+Ctrl+I {
        move-workspace-up
    }
    Mod+WheelScrollDown cooldown-ms=150 {
        focus-workspace-down
    }
    Mod+WheelScrollUp cooldown-ms=150 {
        focus-workspace-up
    }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 {
        move-column-to-workspace-down
    }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 {
        move-column-to-workspace-up
    }
    Mod+WheelScrollRight {
        focus-column-right
    }
    Mod+WheelScrollLeft {
        focus-column-left
    }
    Mod+Ctrl+WheelScrollRight {
        move-column-right
    }
    Mod+Ctrl+WheelScrollLeft {
        move-column-left
    }
    Mod+Shift+WheelScrollDown {
        focus-column-right
    }
    Mod+Shift+WheelScrollUp {
        focus-column-left
    }
    Mod+Ctrl+Shift+WheelScrollDown {
        move-column-right
    }
    Mod+Ctrl+Shift+WheelScrollUp {
        move-column-left
    }
    Mod+1 {
        focus-workspace "web"
    }
    Mod+2 {
        focus-workspace "social"
    }
    Mod+3 {
        focus-workspace "game"
    }
    Mod+4 {
        focus-workspace "misc"
    }
    Mod+5 {
        focus-workspace "system"
    }
    Mod+6 {
        focus-workspace "scratch"
    }
    Mod+7 {
        focus-workspace 7
    }
    Mod+8 {
        focus-workspace 8
    }
    Mod+9 {
        focus-workspace 9
    }
    Mod+Shift+1 {
        move-column-to-workspace "web"
    }
    Mod+Shift+2 {
        move-column-to-workspace "social"
    }
    Mod+Shift+3 {
        move-column-to-workspace "game"
    }
    Mod+Shift+4 {
        move-column-to-workspace "misc"
    }
    Mod+Shift+5 {
        move-column-to-workspace "system"
    }
    Mod+Shift+6 {
        move-column-to-workspace "scratch"
    }
    Mod+Shift+7 {
        move-column-to-workspace 7
    }
    Mod+Shift+8 {
        move-column-to-workspace 8
    }
    Mod+Shift+9 {
        move-column-to-workspace 9
    }
    Mod+BracketLeft {
        consume-or-expel-window-left
    }
    Mod+BracketRight {
        consume-or-expel-window-right
    }
    Mod+Comma {
        consume-window-into-column
    }
    Mod+Period {
        expel-window-from-column
    }
    Mod+R {
        switch-preset-column-width
    }
    Mod+Shift+R {
        switch-preset-window-height
    }
    Mod+Ctrl+R {
        reset-window-height
    }
    Mod+F {
        maximize-column
    }
    Mod+Shift+F {
        fullscreen-window
    }
    Mod+C {
        center-column
    }
    Mod+Minus {
        set-column-width "-10%"
    }
    Mod+Equal {
        set-column-width "+10%"
    }
    Mod+Shift+Minus {
        set-window-height "-10%"
    }
    Mod+Shift+Equal {
        set-window-height "+10%"
    }
    Mod+V {
        toggle-window-floating
    }
    Mod+Shift+V {
        switch-focus-between-floating-and-tiling
    }
    Print {
        screenshot
    }
    Ctrl+Print {
        screenshot-screen
    }
    Alt+Print {
        screenshot-window
    }
    Mod+Shift+E {
        quit
    }
    Ctrl+Alt+Delete {
        quit
    }
}

// Keep this last: included values override the static fallback colors above.
// Niri watches the generated file and live-reloads it after a mode transition.
include "/home/evan/.cache/darkman/niri.kdl"
