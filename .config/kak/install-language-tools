#!/usr/bin/env python3
"""Install pinned Clojure tools into ~/.local (Linux x86_64, including musl)."""
import hashlib
import os
import tempfile
import io
from pathlib import Path
import platform
import shutil
import tarfile
import urllib.request
import zipfile

if platform.system() != 'Linux' or platform.machine() != 'x86_64':
    raise SystemExit('These release assets require Linux x86_64.')
prefix = Path.home() / '.local'
bin_dir = prefix / 'bin'
bin_dir.mkdir(parents=True, exist_ok=True)

def download(repo, tag, asset):
    base = f'https://github.com/{repo}/releases/download/{tag}/{asset}'
    data = urllib.request.urlopen(base).read()
    expected = urllib.request.urlopen(base + '.sha256').read().decode().split()[0]
    if hashlib.sha256(data).hexdigest() != expected:
        raise SystemExit(f'Checksum mismatch for {asset}')
    return data

def write(path, data, executable=False):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix=path.name + '.')
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data)
        os.chmod(temporary, 0o755 if executable else 0o644)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

lsp = download('clojure-lsp/clojure-lsp', '2026.07.06-14.34.19', 'clojure-lsp-native-static-linux-amd64.zip')
with zipfile.ZipFile(io.BytesIO(lsp)) as archive:
    write(bin_dir / 'clojure-lsp', archive.read('clojure-lsp'), True)
print('Installed clojure-lsp 2026.07.06-14.34.19', flush=True)

bb = download('babashka/babashka', 'v1.13.220', 'babashka-1.13.220-linux-amd64-static.tar.gz')
with tarfile.open(fileobj=io.BytesIO(bb)) as archive:
    write(bin_dir / 'bb', archive.extractfile('bb').read(), True)
print('Installed Babashka 1.13.220', flush=True)

version = '1.12.6.1673'
cli = download('clojure/brew-install', version, f'clojure-tools-{version}.tar.gz')
lib = prefix / 'lib/clojure'
with tarfile.open(fileobj=io.BytesIO(cli)) as archive:
    def read(name): return archive.extractfile('clojure-tools/' + name).read()
    for name in ['deps.edn', 'example-deps.edn', 'tools.edn']:
        write(lib / name, read(name))
    for name in ['exec.jar', f'clojure-tools-{version}.jar']:
        write(lib / 'libexec' / name, read(name))
    write(bin_dir / 'clojure', read('clojure').replace(b'PREFIX', str(lib).encode()), True)
    write(bin_dir / 'clj', read('clj').replace(b'BINDIR', str(bin_dir).encode()), True)
print(f'Installed Clojure CLI {version}; JVM Clojure also needs Java on PATH.', flush=True)

# A local musl JDK avoids requiring root on Chimera. Keep an existing Java.
if not shutil.which('java'):
    name = 'OpenJDK21U-jdk_x64_alpine-linux_hotspot_21.0.12.1_1.tar.gz'
    base = 'https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/' + name
    data = urllib.request.urlopen(base).read()
    expected = urllib.request.urlopen(base + '.sha256.txt').read().decode().split()[0]
    if hashlib.sha256(data).hexdigest() != expected:
        raise SystemExit('JDK checksum mismatch')
    destination = prefix / 'share/kak-tools'
    destination.mkdir(parents=True, exist_ok=True)
    with tarfile.open(fileobj=io.BytesIO(data)) as archive:
        top = Path(archive.getmembers()[0].name).parts[0]
        archive.extractall(destination, filter='data')
    for command in ['java', 'javac', 'jar', 'javadoc']:
        link = bin_dir / command
        if not link.exists():
            link.symlink_to(destination / top / 'bin' / command)
    print('Installed local Temurin JDK 21.0.12.1+1 (musl)', flush=True)

# The distro's kak-lsp 18.2 predates this Kakoune's selection commands.
# Use a release that supports Kakoune 2026, including multiline text edits.
url = 'https://github.com/kakoune-lsp/kakoune-lsp/releases/download/v21.0.2/kakoune-lsp-v21.0.2-x86_64-unknown-linux-musl.tar.gz'
data = urllib.request.urlopen(url).read()
if hashlib.sha256(data).hexdigest() != 'b56681350d969ae041c029eeed7aea93c4ad06457fa7862871c78b76bdbcbf91':
    raise SystemExit('kak-lsp checksum mismatch')
with tarfile.open(fileobj=io.BytesIO(data)) as archive:
    write(bin_dir / 'kak-lsp', archive.extractfile('kak-lsp').read(), True)
print('Installed kak-lsp 21.0.2', flush=True)

fmt = download('weavejester/cljfmt', '0.16.5', 'cljfmt-0.16.5-linux-amd64-static.tar.gz')
with tarfile.open(fileobj=io.BytesIO(fmt)) as archive:
    write(bin_dir / 'cljfmt', archive.extractfile('cljfmt').read(), True)
print('Installed cljfmt 0.16.5', flush=True)
