[Unit]
Description=Monitor Brave Share audio on Topping DX5 II
After=pipewire.service wireplumber.service
BindsTo=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/pw-loopback --name brave-share-monitor --latency 20 --capture brave_share "--capture-props={ stream.capture.sink = true node.passive = true }" --playback alsa_output.usb-Topping_DX5_II-00.HiFi__Headphones__sink
Restart=on-failure
RestartSec=2

[Install]
WantedBy=pipewire.service
