"""
Insert login information using Bitwarden CLI and a dmenu-compatible application
(e.g. dmenu, rofi -dmenu, ...).
"""

USAGE = """The domain of the site has to be in the name of the Bitwarden entry, for example: "github.com/cryzed" or
"websites/github.com".  The login information is inserted by emulating key events using qutebrowser's fake-key command in this manner:
[USERNAME]<Tab>[PASSWORD], which is compatible with almost all login forms. Use
--insert-text for the faster single-command path, which only suits simple forms
(see the note on insert_text below).

You must have an unlocked rbw vault prior to use of this script; rbw-agent
handles unlocking itself.

To use in qutebrowser, run: `spawn --userscript qute-bitwarden`
"""

EPILOG = """Dependencies: tldextract (Python 3 module), Bitwarden CLI (1.7.4 is
known to work but older versions may well also work)

WARNING: The login details are viewable as plaintext in qutebrowser's debug log
(qute://log) and might be shared if you decide to submit a crash report!"""

import argparse
import enum
import functools
import json
import os
import shlex
import subprocess
import sys
import tempfile
import time
from urllib.parse import urlparse

CACHE_FILENAME = 'qute-bitwarden-last.json'
CACHE_TTL_SECONDS = 60

argument_parser = argparse.ArgumentParser(
    description=__doc__,
    usage=USAGE,
    epilog=EPILOG,
)
argument_parser.add_argument('url', nargs='?', default=os.getenv('QUTE_URL'))
argument_parser.add_argument('--dmenu-invocation', '-d', default='rofi -dmenu -i -p Bitwarden',
                             help='Invocation used to execute a dmenu-provider')
argument_parser.add_argument('--no-insert-mode', '-n', dest='insert_mode', action='store_false',
                             help="Don't automatically enter insert mode")
argument_parser.add_argument('--io-encoding', '-i', default='UTF-8',
                             help='Encoding used to communicate with subprocesses')
argument_parser.add_argument('--merge-candidates', '-m', action='store_true',
                             help='Merge pass candidates for fully-qualified and registered domain name')
argument_parser.add_argument('--insert-text', '-I', dest='use_insert_text',
                             action='store_true',
                             help='Insert with one insert-text command instead of per-character key events')
# Accepted for compatibility with existing bindings; per-character key events
# are the default now, so this is a no-op.
argument_parser.add_argument('--fake-key', '-k', action='store_true',
                             help=argparse.SUPPRESS)
group = argument_parser.add_mutually_exclusive_group()
group.add_argument('--username-only', '-e',
                   action='store_true', help='Only insert username')
group.add_argument('--password-only', '-w',
                   action='store_true', help='Only insert password')

stderr = functools.partial(print, file=sys.stderr)


class ExitCodes(enum.IntEnum):
    SUCCESS = 0
    FAILURE = 1
    # 1 is automatically used if Python throws an exception
    NO_PASS_CANDIDATES = 2
    COULD_NOT_MATCH_USERNAME = 3
    COULD_NOT_MATCH_PASSWORD = 4


def qute_command(command):
    with open(os.environ['QUTE_FIFO'], 'w') as fifo:
        fifo.write(command + '\n')
        fifo.flush()


def normalize_hostname(hostname):
    return (hostname or '').lower().rstrip('.')


def cache_path():
    directory = os.environ.get('XDG_RUNTIME_DIR') or tempfile.gettempdir()
    return os.path.join(directory, CACHE_FILENAME)


def read_cache(hostname):
    """Return the cached entry id for hostname, or None."""
    try:
        with open(cache_path(), 'r') as cache_file:
            cache = json.load(cache_file)
        if normalize_hostname(cache.get('hostname')) != hostname:
            return None
        if time.time() - float(cache.get('timestamp', 0)) > CACHE_TTL_SECONDS:
            return None
        return cache.get('id') or None
    except (OSError, ValueError, TypeError, AttributeError):
        return None


def write_cache(hostname, selection):
    """Store only non-secret metadata: hostname, entry id and entry name."""
    path = cache_path()
    directory = os.path.dirname(path) or '.'
    payload = {
        'hostname': hostname,
        'id': selection['id'],
        'name': selection['name'],
        'timestamp': time.time(),
    }
    temp_fd = None
    temp_path = None
    try:
        temp_fd, temp_path = tempfile.mkstemp(dir=directory, prefix='.qute-bitwarden-')
        os.fchmod(temp_fd, 0o600)
        with os.fdopen(temp_fd, 'w') as temp_file:
            temp_fd = None
            json.dump(payload, temp_file)
        os.replace(temp_path, path)
        temp_path = None
    except OSError:
        pass
    finally:
        if temp_fd is not None:
            try:
                os.close(temp_fd)
            except OSError:
                pass
        if temp_path is not None:
            try:
                os.unlink(temp_path)
            except OSError:
                pass


def list_candidates(url, encoding):
    """Return matching metadata without fetching any decrypted passwords."""
    process = subprocess.run(['rbw', 'list', '--raw'], capture_output=True)
    if process.returncode:
        stderr(process.stderr.decode(encoding).strip())
        return []

    hostname = normalize_hostname(urlparse(url).hostname)
    entries = json.loads(process.stdout.decode(encoding))
    candidates = []
    for entry in entries:
        for uri in entry.get('uris') or []:
            parsed = urlparse(uri if '://' in uri else '//' + uri)
            saved_hostname = normalize_hostname(parsed.hostname)
            if saved_hostname and (
                hostname == saved_hostname or hostname.endswith('.' + saved_hostname)
            ):
                candidates.append({
                    'id': entry['id'],
                    'name': entry['name'],
                    'login': {'username': entry.get('user') or ''},
                })
                break
    if candidates:
        return candidates

    # Some services keep authentication on a different parent domain from the
    # URI stored in Bitwarden. Fall back to a searchable picker of every login
    # rather than failing without giving the user a choice.
    return [
        {
            'id': entry['id'],
            'name': entry['name'],
            'login': {'username': entry.get('user') or ''},
        }
        for entry in entries
        if (entry.get('type') or '').lower() == 'login'
    ]


def dmenu(items, invocation, encoding):
    command = shlex.split(invocation)
    process = subprocess.run(command, input='\n'.join(
        items).encode(encoding), stdout=subprocess.PIPE)
    return process.stdout.decode(encoding).strip()


def fake_key_raw(text):
    for character in text:
        # Escape all characters by default, space requires special handling
        sequence = '" "' if character == ' ' else r'\{}'.format(character)
        qute_command('fake-key {}'.format(sequence))


def mangled_by_command_parser(text):
    """Return True if qutebrowser's command parser would alter this text.

    :insert-text is registered with maxsplit=0, so the text is not quoted or
    escaped -- but it is still run through the command parser first, which
    strips surrounding whitespace, splits the line on ';;', and expands
    variables such as {url}, {title}, {clipboard} and {primary}. A newline
    would additionally terminate the FIFO command early.

    Leading '-' matters too: the parser treats whitespace-separated leading
    tokens that start with '-' as flags, so '-pw with spaces' arrives as
    'spaces'.
    """
    return (
        text != text.strip()
        or text.startswith('-')
        or ';;' in text
        or '{' in text
        or '\n' in text
        or '\r' in text
    )


def insert_text(text):
    """Insert with a single :insert-text command.

    Not the default, and not safe for the username<Tab>password sequence.
    :insert-text resolves its target through find_focused(), which is an
    async JS round-trip (run_js_async), while fake-key is synchronous. The
    <Tab> therefore lands before either insertion resolves and both strings
    end up in whichever field is focused by then. Its JS also reads
    document.activeElement without descending into shadow roots, so on a site
    whose login is a web component it targets the host and types nothing.
    """
    if not text:
        # :insert-text rejects an empty argument, while fake_key_raw is a
        # no-op for one; keep the empty case harmless either way.
        return
    if mangled_by_command_parser(text):
        fake_key_raw(text)
        return
    qute_command('insert-text {}'.format(text))


def main(arguments):
    if not arguments.url:
        argument_parser.print_help()
        return ExitCodes.FAILURE

    insert = insert_text if arguments.use_insert_text else fake_key_raw

    candidates = list_candidates(arguments.url, arguments.io_encoding)
    if not candidates:
        stderr('No pass candidates for URL {!r} found!'.format(arguments.url))
        return ExitCodes.NO_PASS_CANDIDATES

    hostname = normalize_hostname(urlparse(arguments.url).hostname)

    selection = None
    cached_id = read_cache(hostname)
    if cached_id:
        selection = next(
            (c for c in candidates if c['id'] == cached_id), None)

    if selection is None:
        if len(candidates) == 1:
            selection = candidates.pop()
        else:
            choices = ['{:s} | {:s}'.format(c['name'], c['login']['username']) for c in candidates]
            choice = dmenu(choices, arguments.dmenu_invocation, arguments.io_encoding)
            choice_tokens = choice.split('|')
            choice_name = choice_tokens[0].strip()
            choice_username = choice_tokens[1].strip()
            selection = next((c for (i, c) in enumerate(candidates)
                              if c['name'] == choice_name
                              and c['login']['username'] == choice_username),
                             None)

    # Nothing was selected, simply return
    if not selection:
        return ExitCodes.SUCCESS

    process = subprocess.run(
        ['rbw', 'get', '--raw', selection['id']],
        capture_output=True,
    )
    if process.returncode:
        stderr(process.stderr.decode(arguments.io_encoding).strip())
        return ExitCodes.FAILURE
    login = json.loads(process.stdout.decode(arguments.io_encoding))['data']
    username = login.get('username') or ''
    password = login.get('password') or ''

    # Refresh the cache timestamp so a follow-up invocation skips the picker.
    write_cache(hostname, selection)

    if arguments.username_only:
        insert(username)
    elif arguments.password_only:
        insert(password)
    else:
        # Enter username and password, separated by <Tab> (which seems to work
        # almost universally), then switch back into insert-mode, so the form
        # can be directly submitted by hitting enter afterwards.
        insert(username)
        qute_command('fake-key <Tab>')
        insert(password)

    if arguments.insert_mode:
        qute_command('mode-enter insert')

    return ExitCodes.SUCCESS


if __name__ == '__main__':
    arguments = argument_parser.parse_args()
    sys.exit(main(arguments))
