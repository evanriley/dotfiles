#!/bin/sh

set -eu

source_image=${1:?missing source wallpaper}
output_image=${2:?missing output path}
dim=${3:?missing dim opacity}
font=${XDG_DATA_HOME:-$HOME/.local/share}/fonts/NerdFontsSymbolsOnly/SymbolsNerdFontMono-Regular.ttf
temporary_image=${output_image}.new.jpg

if [ ! -f "$font" ]; then
    font=/usr/share/fonts/nerd-symbols-only/SymbolsNerdFontMono-Regular.ttf
fi

# Preserve the wallpaper dimensions, darken it uniformly, then add a crisp
# centered lock mark. Write atomically so swaylock never sees a partial JPEG.
ffmpeg -hide_banner -loglevel error -y \
    -i "$source_image" \
    -vf "drawbox=x=0:y=0:w=iw:h=ih:color=black@${dim}:t=fill,drawtext=fontfile=${font}:text='󰌾':fontcolor=white@0.92:fontsize=112:shadowcolor=black@0.65:shadowx=3:shadowy=3:x=(w-text_w)/2:y=(h-text_h)/2" \
    -frames:v 1 \
    -q:v 2 \
    "$temporary_image"

mv "$temporary_image" "$output_image"
