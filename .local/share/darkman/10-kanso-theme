#!/bin/sh

set -eu

mode=${1:?expected light or dark}
state_root=${XDG_STATE_HOME:-$HOME/.local/state}/darkman
config_root=${XDG_CONFIG_HOME:-$HOME/.config}
helper_dir=$config_root/darkman
mkdir -p "$state_root"

# Most of this hook is best-effort: a reload that fails costs one stale window.
# The failures reported here are the ones that outlast the transition, so they
# are named rather than swallowed. darkman records hook output, and the
# notification reaches the user while the cause is still on screen.
report_failure() {
    failure_summary=$1
    failure_expectation=$2
    failure_check=$3

    printf 'darkman: %s.\n' "$failure_summary" >&2
    printf 'expected %s\n' "$failure_expectation" >&2
    printf 'check: %s\n' "$failure_check" >&2
    notify-send --urgency=critical "$failure_summary" \
        "$failure_expectation Check: $failure_check" 2>/dev/null || true
}

case "$mode" in
dark)
    # Kanso Zen.
    bg=090E13; bg_alt=1C1E25; bg_soft=22262D; surface=393B44
    selection=22262D; border=393B44; muted=909398; fg=C5C9C7
    blue=8ba4b0; cyan=8ea4a2; green=8a9a7b; green_alt=87a987
    magenta=a292a3; yellow=c4b28a; yellow_bright=E6C384; red=c4746e
    fg_alt=A4A7A4; rust=b6927b
    # ANSI bright blue, magenta and red, from the upstream Kanso terminal port.
    blue_bright=7FB4CA; magenta_bright=938AA9; red_bright=E46876
    shadow=090E13
    # Kanso diffGreen/diffRed; the emphasis tones blend 35% toward
    # gitGreen #76946A and gitRed #C34043.
    diff_add=2B3328; diff_add_emph=45553F
    diff_del=43242B; diff_del_emph=702E33
    delta_syntax_theme=zenburn
    gtk_theme=Adwaita-dark; icon_theme=breeze-dark; color_scheme=prefer-dark
    foot_signal=USR1
    lock_bg=090E13
    ;;
light)
    # Kanso Pearl.
    bg=f2f1ef; bg_alt=e2e1df; bg_soft=dddddb; surface=cacac7
    # muted is pearlBlack1 rather than the lighter pearlGray3 so that secondary
    # text clears 4.5:1 on bg_alt and on selection, not only on bg.
    selection=dddddb; border=cacac7; muted=545464; fg=22262D
    blue=4d699b; cyan=597b75; green=6f894e; green_alt=6e915f
    magenta=b35b79; yellow=836f4a; yellow_bright=de9800; red=c84053
    # fg_alt is pearlBlack2, which keeps fg > fg_alt > muted ordered by
    # prominence in both modes.
    fg_alt=43436c; rust=cc6d00
    # ANSI bright blue, magenta and red, from the upstream Kanso terminal port.
    blue_bright=6693bf; magenta_bright=624c83; red_bright=d7474b
    shadow=22262D
    # pearlGreen3 #b7d0ae and pearlRed4 #d9a594 carry the emphasis, with the
    # base tones the same colors at 50% over pearlWhite0.
    diff_add=d4e0ce; diff_add_emph=b7d0ae
    diff_del=e5cbc1; diff_del_emph=d9a594
    delta_syntax_theme=gruvbox-light
    gtk_theme=Adwaita; icon_theme=breeze; color_scheme=default
    foot_signal=USR2
    lock_bg=9F9F99
    ;;
*)
    printf 'unknown mode: %s\n' "$mode" >&2
    exit 2
    ;;
esac

cat >"$state_root/palette.css" <<EOF
@define-color background #$bg;
@define-color background_alt #$bg_alt;
@define-color background_soft #$bg_soft;
@define-color surface #$surface;
@define-color selection #$selection;
@define-color border #$border;
@define-color muted #$muted;
@define-color foreground #$fg;
@define-color primary #$blue;
@define-color cyan #$cyan;
@define-color success #$green;
@define-color success_alt #$green_alt;
@define-color accent #$magenta;
@define-color warning #$yellow;
@define-color warning_bright #$yellow_bright;
@define-color error #$red;
EOF

cat >"$state_root/fuzzel.ini" <<EOF
[colors]
background=${bg}ff
text=${fg}ff
prompt=${yellow}ff
placeholder=${muted}ff
border=${border}ff
selection=${selection}ff
selection-text=${fg}ff
match=${blue}ff
selection-match=${magenta}ff
EOF

cat >"$state_root/foot.ini" <<EOF
[main]
initial-color-theme=$mode
EOF

cat >"$state_root/swaylock.conf" <<EOF
# Static images, generated once and tracked, not rebuilt per transition: the
# only thing that varies between modes is which of the two is used. color= is
# the fallback for anything the image does not cover.
image=$helper_dir/lockscreen-$mode.png
scaling=fill
color=$lock_bg
font=Berkeley Mono
font-size=24
indicator-radius=72
indicator-thickness=8
indicator-caps-lock
show-failed-attempts
ignore-empty-password
inside-color=${bg}e6
inside-clear-color=${bg_alt}e6
inside-caps-lock-color=${bg_alt}e6
inside-ver-color=${bg_alt}e6
inside-wrong-color=${bg_alt}e6
ring-color=$blue
ring-clear-color=$green
ring-caps-lock-color=$yellow_bright
ring-ver-color=$cyan
ring-wrong-color=$red
key-hl-color=$magenta
bs-hl-color=$red
separator-color=00000000
line-color=00000000
text-color=$fg
text-clear-color=$fg
text-caps-lock-color=$yellow_bright
text-ver-color=$cyan
text-wrong-color=$red
layout-bg-color=${bg_alt}e6
layout-border-color=$border
layout-text-color=$fg
EOF

cat >"$state_root/niri.kdl" <<EOF
layout {
    focus-ring {
        active-color "#$blue"
        inactive-color "#$border"
    }
    border {
        active-gradient from="#$bg_alt" to="#$red" angle=45 relative-to="workspace-view"
        inactive-color "#$bg_alt"
    }
    tab-indicator {
        active-gradient from="#$yellow" to="#$red" angle=45
        inactive-gradient from="#$border" to="#$muted" angle=45 relative-to="workspace-view"
        urgent-gradient from="#$red_bright" to="#$red" angle=45
    }
    shadow {
        color "#${shadow}70"
        inactive-color "#${shadow}54"
    }
}
overview {
    backdrop-color "#$bg_alt"
}
EOF

# git's include silently ignores a missing path, so a checkout where darkman
# has never run simply falls back to delta's own defaults.
cat >"$state_root/delta.gitconfig" <<EOF
[delta]
    dark = $(test "$mode" = dark && printf true || printf false)
    light = $(test "$mode" = light && printf true || printf false)
    syntax-theme = $delta_syntax_theme
    file-style = bold "#$blue"
    file-decoration-style = "#$border" ul
    hunk-header-style = file line-number syntax
    hunk-header-file-style = "#$fg_alt"
    hunk-header-line-number-style = "#$rust"
    hunk-header-decoration-style = "#$border" box
    commit-style = raw
    commit-decoration-style = "#$border" box
    zero-style = syntax
    plus-style = syntax "#$diff_add"
    plus-non-emph-style = syntax "#$diff_add"
    plus-emph-style = syntax "#$diff_add_emph"
    minus-style = syntax "#$diff_del"
    minus-non-emph-style = syntax "#$diff_del"
    minus-emph-style = syntax "#$diff_del_emph"
    line-numbers = true
    line-numbers-left-style = "#$border"
    line-numbers-right-style = "#$border"
    line-numbers-zero-style = "#$muted"
    line-numbers-minus-style = "#$red"
    line-numbers-plus-style = "#$green"
    whitespace-error-style = "#$bg" "#$red"
    blame-palette = "#$bg #$bg_alt #$bg_soft #$surface"
EOF

# fish sources this only if it exists, so a shell started before darkman has ever
# run simply keeps fzf's own default colors.
cat >"$state_root/fzf.fish" <<EOF
set -gx FZF_DEFAULT_OPTS \\
    '--color=fg:#$fg,bg:#$bg,hl:#$red' \\
    '--color=fg+:#$fg,bg+:#$selection,hl+:#$red_bright' \\
    '--color=info:#$yellow,prompt:#$green,pointer:#$green' \\
    '--color=marker:#$green,spinner:#$yellow,header:#$blue'
EOF

cat >"$state_root/mpv.conf" <<EOF
osd-color='#$fg'
osd-border-color='#$bg'
osd-shadow-color='#$bg'
EOF

# ~/.config/gtk-3.0/settings.ini and ~/.config/gtk-4.0/settings.ini are tracked
# symlinks to this file, so grepping the repo for its name finds nothing but
# this block. GTK reads settings.ini once at application startup; the settings
# portal carries color-scheme to already-running applications.
cat >"$state_root/gtk-settings.ini" <<EOF
[Settings]
gtk-application-prefer-dark-theme=$(test "$mode" = dark && printf true || printf false)
gtk-theme-name=$gtk_theme
gtk-icon-theme-name=$icon_theme
EOF

cat >"$state_root/zathurarc" <<EOF
set default-bg "#$bg"
set default-fg "#$fg"
set statusbar-bg "#$bg_alt"
set statusbar-fg "#$fg"
set inputbar-bg "#$bg_alt"
set inputbar-fg "#$fg"
set completion-bg "#$bg"
set completion-fg "#$fg"
set completion-group-bg "#$bg_alt"
set completion-group-fg "#$muted"
set completion-highlight-bg "#$selection"
set completion-highlight-fg "#$fg"
set notification-bg "#$bg_alt"
set notification-fg "#$fg"
set notification-error-bg "#$bg_alt"
set notification-error-fg "#$red"
set notification-warning-bg "#$bg_alt"
set notification-warning-fg "#$yellow_bright"
set index-bg "#$bg"
set index-fg "#$fg"
set index-active-bg "#$selection"
set index-active-fg "#$fg"
set highlight-color "#$selection"
set highlight-active-color "#$yellow"
set highlight-fg "#$fg"
set render-loading-bg "#$bg"
set render-loading-fg "#$fg"
set signature-error-color "#$red"
set signature-warning-color "#$yellow_bright"
set signature-success-color "#$green"
set recolor $(test "$mode" = dark && printf true || printf false)
set recolor-darkcolor "#$fg"
set recolor-lightcolor "#$bg"
set recolor-keephue true
set recolor-adjust-lightness true
set recolor-reverse-video true
EOF

cp "$helper_dir/swayimg-base.ini" "$state_root/swayimg.ini"
cat >>"$state_root/swayimg.ini" <<EOF
[viewer]
window = #${bg}ff
transparency = #${bg}ff
[slideshow]
window = #${bg}ff
transparency = #${bg}ff
[gallery]
window = #${bg}ff
background = #${bg_alt}ff
select = #${selection}ff
border = #${blue}ff
shadow = #${bg}b0
[font]
color = #${fg}ff
shadow = #${bg}d0
background = #00000000
EOF

# Exactly the keys config.py validates in PALETTE_KEYS, plus the mode it
# reads for forced dark mode. A key this file carries and config.py ignores is
# a claim that the browser follows it.
cat >"$state_root/qutebrowser.conf" <<EOF
mode=$mode
bg=#$bg
bg_alt=#$bg_alt
bg_soft=#$bg_soft
selection=#$selection
border=#$border
muted=#$muted
fg=#$fg
fg_alt=#$fg_alt
blue=#$blue
green=#$green
green_alt=#$green_alt
magenta=#$magenta
yellow=#$yellow
yellow_bright=#$yellow_bright
red=#$red
rust=#$rust
EOF

# rmpc and btop take a whole theme file rather than a palette include, so the
# literal Kanso Zen themes are recolored into the active mode while their
# structure and behavior stay intact. In dark mode this is an identity
# substitution. The templates spell hex digits in mixed case, so every pattern
# matches case-insensitively.
recolor_kanso_zen() {
    sed \
        -e "s/#090e13/#$bg/gI" \
        -e "s/#c5c9c7/#$fg/gI" \
        -e "s/#a4a7a4/#$fg_alt/gI" \
        -e "s/#393b44/#$border/gI" \
        -e "s/#8ba4b0/#$blue/gI" \
        -e "s/#8ea4a2/#$cyan/gI" \
        -e "s/#8a9a7b/#$green/gI" \
        -e "s/#a292a3/#$magenta/gI" \
        -e "s/#c4b28a/#$yellow/gI" \
        -e "s/#c4746e/#$red/gI" \
        -e "s/#7fb4ca/#$blue_bright/gI" \
        -e "s/#938aa9/#$magenta_bright/gI" \
        -e "s/#e46876/#$red_bright/gI" \
        "$1"
}

# A redirect truncates its target before sed runs, so a missing or renamed
# source would leave rmpc or btop reading an empty theme -- and under set -e
# would abort the hook, stranding the rest of the desktop in the previous mode.
# Writing beside the target and renaming keeps the last good palette instead.
write_recolored() {
    recolor_source=$1
    recolor_target=$2

    if recolor_kanso_zen "$recolor_source" >"$recolor_target.new"; then
        mv -f "$recolor_target.new" "$recolor_target"
    else
        rm -f "$recolor_target.new"
        report_failure \
            "failed to recolor $recolor_source" \
            "a readable Kanso Zen theme; $recolor_target keeps its previous contents." \
            "ls -l $recolor_source"
    fi
}

write_recolored "$config_root/rmpc/themes/kanso-zen.ron" "$state_root/rmpc.ron"
write_recolored "$config_root/btop/themes/kanso-zen.theme" "$state_root/btop.theme"

gsettings set org.gnome.desktop.interface color-scheme "$color_scheme" 2>/dev/null || true
gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme" 2>/dev/null || true
gsettings set org.gnome.desktop.interface icon-theme "$icon_theme" 2>/dev/null || true

# SIGUSR1 and SIGUSR2 default to Term, so a program that binds them as reload
# signals -- foot, waybar and swayimg all do -- is killed outright by one
# delivered before its handler is installed. Measured on foot 1.27 that window
# is under 50ms; a GTK client like waybar takes longer. niri's
# spawn-at-startup races this hook at login, so every reload signal goes
# through here rather than through a bare pkill.
#
# A process too young to signal has just read the state files written above and
# is already in the requested mode. The exception is one that exec'd in the few
# milliseconds between this script starting and those writes: it keeps the
# previous palette until the next transition, which is the price of not killing
# it. Age comes from procps ps, which reports whole seconds, so the skip window
# is up to two seconds wide; without ps nothing is signalled at all, and a
# stale palette everywhere still beats a killed window.
signal_settled_seconds=1

signal_settled() {
    signal_name=$1
    signal_program=$2

    for signal_pid in $(pgrep -x "$signal_program" 2>/dev/null || true); do
        signal_age=$(ps -o etimes= -p "$signal_pid" 2>/dev/null | tr -d ' ')
        if [ "${signal_age:-0}" -ge "$signal_settled_seconds" ]; then
            kill -"$signal_name" "$signal_pid" 2>/dev/null || true
        fi
    done
}

signal_settled "$foot_signal" foot
# An optional include that did not exist when niri started is not watched, so
# the first run after a wiped state directory needs an explicit reload.
niri msg action load-config-file >/dev/null 2>&1 || true
signal_settled USR2 waybar
signal_settled USR1 swayimg
swaync-client --reload-css 2>/dev/null || true
swaync-client --reload-config 2>/dev/null || true
# btop reads its theme only at startup. SIGUSR1 is handled but does not re-read
# it, so the scratchpad is restarted instead. niri does the spawning, which is
# what gives the new window the same environment and window rules as the
# spawn-at-startup entry that created it -- spawning from here would inherit
# darkman's environment instead. Only restarts a scratchpad that is already
# open, so a closed one is not resurrected on every mode change.
#
# The window rules put a new scratchpad on the scratch workspace unfocused, so
# a bare respawn takes back a scratchpad the user had toggled out onto a
# visible workspace. From the user's side that is indistinguishable from the
# window closing itself on every theme change, so placement and focus are
# captured first and reapplied to the replacement.
scratch_workspace=${NS_WORKSPACE:-scratch}

scratch_window_id() {
    niri msg --json windows 2>/dev/null |
        jq -r --arg id "$1" 'first(.[] | select(.app_id == $id) | .id) // empty'
}

# Fails while the only window carrying the app id is still the one that was
# killed, so the caller can poll for the window niri has yet to map.
scratch_replacement_id() {
    scratch_candidate=$(scratch_window_id "$1")
    if [ -z "$scratch_candidate" ] || [ "$scratch_candidate" = "$2" ]; then
        return 1
    fi
    printf '%s\n' "$scratch_candidate"
}

restart_scratchpad() {
    scratch_app_id=$1
    shift

    # One snapshot. Separate queries would capture separate moments, and the
    # window can be moved or closed between them.
    scratch_window=$(
        niri msg --json windows 2>/dev/null |
            jq -r --arg id "$scratch_app_id" \
                'first(.[] | select(.app_id == $id) |
                    [.pid, .id, .workspace_id, .is_focused] |
                    map(tostring) | join(" ")) // empty'
    )
    [ -n "$scratch_window" ] || return 0

    read -r scratch_pid scratch_old_id scratch_ws_id scratch_focused <<SCRATCH
$scratch_window
SCRATCH

    scratch_home=$(
        niri msg --json workspaces 2>/dev/null |
            jq -r --argjson ws "$scratch_ws_id" \
                'first(.[] | select(.id == $ws) | (.name // (.idx | tostring))) // empty'
    )

    kill "$scratch_pid" 2>/dev/null || return 0

    scratch_wait=0
    while [ "$scratch_wait" -lt 20 ] && kill -0 "$scratch_pid" 2>/dev/null; do
        sleep 0.1
        scratch_wait=$((scratch_wait + 1))
    done

    # Two scratchpads stacked on one workspace is worse than a stale palette,
    # so a process that will not die keeps the window it already has.
    if kill -0 "$scratch_pid" 2>/dev/null; then
        return 0
    fi

    niri msg action spawn -- "$@" >/dev/null 2>&1 || true

    scratch_wait=0
    scratch_new_id=""
    while [ "$scratch_wait" -lt 30 ]; do
        if scratch_new_id=$(scratch_replacement_id "$scratch_app_id" "$scratch_old_id"); then
            break
        fi
        sleep 0.1
        scratch_wait=$((scratch_wait + 1))
    done
    [ -n "$scratch_new_id" ] || return 0

    if [ -n "$scratch_home" ] && [ "$scratch_home" != "$scratch_workspace" ]; then
        niri msg action move-window-to-workspace --window-id "$scratch_new_id" \
            --focus=false "$scratch_home" >/dev/null 2>&1 || true
    fi

    # Focus is restored for a scratchpad that was focused on the scratch
    # workspace too, which the placement check above does not cover.
    if [ "$scratch_focused" = true ]; then
        niri msg action focus-window --id "$scratch_new_id" >/dev/null 2>&1 || true
    fi
}

restart_scratchpad scratch_btop foot --app-id=scratch_btop btop

# rmpc replaces its theme in place, so it needs no restart. The remote needs an
# explicit pid; without one it probes every instance it can find and fails.
rmpc_pid=$(pgrep -x rmpc | head -1)
if [ -n "$rmpc_pid" ]; then
    rmpc remote --pid "$rmpc_pid" set theme "$state_root/rmpc.ron" \
        >/dev/null 2>&1 || true
fi

# Reload an existing qutebrowser instance, but never launch one from this
# synchronous hook: darkman waits for every hook command to exit.
if pgrep -u "$(id -u)" -f '[/]usr/bin/qutebrowser( |$)' >/dev/null; then
    qutebrowser ':config-source' >/dev/null 2>&1 || true
fi

# Keep the wallpaper in step with the rest of the desktop theme. Detached
# because the helper waits on dinit, and darkman waits on every hook command.
# A detached child cannot report its own failure, so the one failure worth
# naming -- a helper that is missing or not executable -- is checked here.
if [ -x "$helper_dir/set-wallpaper" ]; then
    setsid -f "$helper_dir/set-wallpaper" "$mode" >/dev/null 2>&1 || true
else
    report_failure \
        'the wallpaper helper is missing or not executable' \
        "the desktop background to follow $mode; it keeps the previous colour." \
        "ls -l $helper_dir/set-wallpaper"
fi

# SwayOSD reads its stylesheet only at startup; its dinit service owns the
# process and ensures that theme reloads cannot create duplicate servers.
# A failure here leaves SwayOSD stopped for the rest of the session, so it is
# reported rather than swallowed. The first hook of a session can run before
# niri has issued the dinitctl that brings desktop-services up, and restarting
# a service that was never started is not the request that was meant.
if dinitctl is-started swayosd >/dev/null 2>&1; then
    swayosd_action=restart
else
    swayosd_action=start
fi
if ! dinitctl "$swayosd_action" swayosd >/dev/null 2>&1; then
    report_failure \
        "failed to $swayosd_action the swayosd dinit service" \
        'SwayOSD to reload its stylesheet; it is now stopped.' \
        'dinitctl status swayosd'
fi
